{
  "name": "playwright-mixtape-reporter",
  "version": "1.0.4",
  "description": "A zero-runtime-dependency Playwright terminal reporter with a live cassette deck, parallel workers, and failure diagnostics.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./metrics": {
      "types": "./dist/metrics.d.ts",
      "default": "./dist/metrics.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "demo.mjs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs/usage.md"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "npm run build && tsc --noEmit",
    "lint": "oxlint --deny-warnings src tests scripts demo.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node --test tests/*.test.*",
    "test:browser": "npm run build && node --test tests/browser.smoke.ts",
    "test:package": "node scripts/check-package.mjs",
    "bench": "npm run build && node scripts/benchmark.mjs",
    "check": "npm run security && npm run release:check && npm run lint && npm run format:check && npm run typecheck && npm test && npm run test:package",
    "release:sync": "node scripts/sync-release-version.mjs",
    "release:check": "node scripts/sync-release-version.mjs --check",
    "demo": "node demo.mjs",
    "security": "node scripts/check-policy.mjs",
    "pack": "npm run build && node scripts/pack.mjs"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.64.1 <2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "oxlint": "1.89.0",
    "prettier": "3.9.10"
  },
  "keywords": [
    "playwright",
    "playwright-reporter",
    "reporter",
    "terminal",
    "cli",
    "ci",
    "api",
    "e2e",
    "mixtape"
  ],
  "author": "Yurii Drapak",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuriidrapak/playwright-mixtape-reporter.git"
  },
  "homepage": "https://github.com/yuriidrapak/playwright-mixtape-reporter#readme",
  "bugs": {
    "url": "https://github.com/yuriidrapak/playwright-mixtape-reporter/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
